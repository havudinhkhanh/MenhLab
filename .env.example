# Sao chép file này thành .env.local khi chạy trên máy, hoặc nhập từng biến vào Vercel → Settings → Environment Variables.
# Dòng bắt đầu bằng # là chú thích.

# ---------- Trang web ----------
NEXT_PUBLIC_SITE_URL=https://menhlab.vercel.app
NEXT_PUBLIC_BRAND=MệnhLab
NEXT_PUBLIC_PRICE_PRO=149000

# Thông tin người quảng cáo — bắt buộc xuất hiện trong email quảng cáo (NĐ 91/2020)
OWNER_NAME=MệnhLab
OWNER_ADDRESS=TP. Hồ Chí Minh, Việt Nam
OWNER_EMAIL=hello@tenmiencuaban.vn
OWNER_PHONE=

# Chuỗi bí mật ngẫu nhiên (ít nhất 32 ký tự) — dùng ký link hủy nhận email, cookie quản trị
APP_SECRET=
# Muối để băm email/IP trong nhật ký đồng ý
HASH_SALT=
# Mật khẩu vào trang /admin
ADMIN_KEY=

# ---------- Supabase (cơ sở dữ liệu) ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Resend (gửi email) ----------
RESEND_API_KEY=
# Sau khi xác thực tên miền trên Resend, đổi thành địa chỉ trên tên miền của bạn
EMAIL_FROM=MệnhLab <hello@tenmiencuaban.vn>
# Chuỗi bí mật để Vercel Cron gọi /api/cron/drip
CRON_SECRET=
# Số email teaser tối đa mỗi lần chạy (gói free Resend giới hạn theo ngày)
DRIP_BATCH=80

# ---------- Thanh toán: chọn payOS (tự động) hoặc chuyển khoản thủ công ----------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Dự phòng khi chưa có payOS: mã BIN ngân hàng (VietQR), số TK, tên chủ TK (viết hoa không dấu)
BANK_BIN=
BANK_ACCOUNT=
BANK_HOLDER=

